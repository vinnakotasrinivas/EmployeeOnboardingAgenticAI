# Free key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
# Llama Guard 4 is not offered on every key; any meta-llama/llama-guard-* model also works here.
GROQ_GUARD_MODEL=openai/gpt-oss-safeguard-20b
# Output cap per LLM call. Keep it below your plan's output-tokens-per-minute limit (1000 on the free tier).
GROQ_MAX_TOKENS=800
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

MAX_FILE_MB=19
TOP_K=5
SIMILARITY_THRESHOLD=0.35
RELEVANCE_THRESHOLD=0.75
# A question is off-topic only if BOTH its topic similarity and its best search hit are below these.
OFF_TOPIC_THRESHOLD=0.45
OFF_TOPIC_SEARCH_THRESHOLD=0.50

API_URL=http://127.0.0.1:8766
DATA_DIR=data
LOG_DIR=logs
